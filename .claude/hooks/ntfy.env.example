# ntfy config for the "Claude needs you" push notification.
# Copy this to ntfy.env (gitignored) and fill in your topic.
#
#   cp .claude/hooks/ntfy.env.example .claude/hooks/ntfy.env
#
# Then pick a hard-to-guess topic (anyone who knows a public ntfy.sh topic can
# read it). Subscribe to the same topic in the ntfy app on your phone.

# Server (default https://ntfy.sh; set to your self-hosted instance if you have one)
NTFY_URL=https://ntfy.sh

# Your topic (REQUIRED — the notifier no-ops while this is empty)
NTFY_TOPIC=

# Optional: bearer token for a protected/self-hosted topic
NTFY_TOKEN=

# Optional cosmetics
NTFY_TITLE="Claude needs you"
NTFY_PRIORITY=high
